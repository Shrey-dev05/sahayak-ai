# Copy to .env and fill in when you're ready to move off mock providers.
# None of these are required to run the prototype - it works with zero
# external accounts out of the box.

DATABASE_URL=sqlite:///./data/sahayak.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/sahayak   # production

QR_SECRET=change-me-to-a-long-random-string
QR_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=3600

LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

STT_PROVIDER=mock
TTS_PROVIDER=mock
OCR_PROVIDER=mock
